Algoritmo ciclo_mientras
	numero <- 0
	Mientras numero<5 Hacer
		Escribir numero
		numero <- numero+1
	FinMientras
	Escribir numero
	Escribir "Cual es tu edad?"
	leer edad
	si edad>15 y edad<30
		Escribir "Puedes participar al evento"
	SiNo
		Escribir "No puedes participar al evento"
	FinSi
FinAlgoritmo
